#!/usr/bin/env bash
# Deletes a Dart SDK sandbox worktree and reclaims disk space instantly.
# Usage: rmagenttree <core|bazel> <task-name>
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: rmagenttree <core|bazel> <task-name>"
    exit 1
fi

CATEGORY="$1"
TASK_NAME="$2"

WORKSPACE_ROOT="$HOME/github/dart-sdk"
BARE_DIR="$WORKSPACE_ROOT/.bare"
SANDBOX_DIR="$WORKSPACE_ROOT/$CATEGORY/agent-$TASK_NAME"
WORKTREE_DIR="$SANDBOX_DIR/sdk"

if [ ! -d "$SANDBOX_DIR" ]; then
    echo "⚠️ Warning: Sandbox directory does not exist at $SANDBOX_DIR"
    echo "Attempting to clean up Git worktree metadata anyway..."
fi

echo "🧹 Removing worktree and purging sandbox: agent-$TASK_NAME..."

# Remove worktree cleanly from Git database
git --git-dir="$BARE_DIR" worktree remove -f "$WORKTREE_DIR" || true

# Clean up any other prunable worktrees in the database
git --git-dir="$BARE_DIR" worktree prune || true

# Purge files if directory exists
if [ -d "$SANDBOX_DIR" ]; then
    rm -rf "$SANDBOX_DIR"
fi

echo "✅ Clean up complete."
