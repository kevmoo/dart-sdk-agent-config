#!/usr/bin/env bash
# Deletes a Dart SDK sandbox worktree and reclaims disk space instantly.
# Usage: rmagenttree <core|bazel> <task-name>
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: rmagenttree <core|bazel> <task-name>"
    exit 1
fi

CATEGORY="$1"
TASK_NAME="$2"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BARE_DIR="$WORKSPACE_ROOT/.bare"
SANDBOX_DIR="$WORKSPACE_ROOT/$CATEGORY/agent-$TASK_NAME"
WORKTREE_DIR="$SANDBOX_DIR/sdk"

echo "🧹 Removing worktree and purging sandbox: agent-$TASK_NAME..."

# Remove main worktree cleanly from Git database if it exists
if [ -d "$WORKTREE_DIR" ]; then
    git --git-dir="$BARE_DIR" worktree remove -f "$WORKTREE_DIR" 2>/dev/null || true
fi

# Purge sandbox directory from disk
if [ -d "$SANDBOX_DIR" ]; then
    rm -rf "$SANDBOX_DIR"
fi

# Clean up any prunable worktrees in the database
git --git-dir="$BARE_DIR" worktree prune || true

echo "✅ Clean up complete."
