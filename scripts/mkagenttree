#!/usr/bin/env bash
# Automatically creates or re-syncs a fully configured Dart SDK sandbox worktree.
# Usage:
#   mkagenttree <core|bazel> <task-name> [base-ref]   # Create new sandbox worktree
#   mkagenttree --sync [path-to-worktree]            # Re-sync / repair existing worktree
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BARE_DIR="$WORKSPACE_ROOT/.bare"

# 1. Pre-flight checks: depot_tools & gcert status
if [ -d "$HOME/github/depot_tools" ]; then
    export PATH="$HOME/github/depot_tools:$PATH"
elif ! command -v gclient &>/dev/null; then
    echo "❌ Error: depot_tools not found in PATH or at $HOME/github/depot_tools."
    echo "   Clone it via: git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git ~/github/depot_tools"
    exit 1
fi

# Prevent depot_tools from attempting auto-update fetch checks during execution
export DEPOT_TOOLS_UPDATE=0
export DEPOT_TOOLS_GIT_CACHE_DIR="$WORKSPACE_ROOT/.git_cache"
mkdir -p "$DEPOT_TOOLS_GIT_CACHE_DIR"

# Pre-flight check for corp SSO / gcert if gcertstatus is available
if command -v gcertstatus &>/dev/null; then
    if ! gcertstatus --check_remaining_hours=0.5 &>/dev/null; then
        echo "❌ Error: gcert is expired or has less than 30 minutes remaining."
        echo "   Please run 'gcert' in your terminal before running SDK bootstrap or sync."
        exit 1
    fi
fi

# Function: Verify toolchain health
verify_toolchain() {
    local worktree="$1"
    echo "🔍 Verifying sandbox toolchain health..."
    local missing=0
    if [ ! -x "$worktree/buildtools/gn" ]; then
        echo "❌ Missing build tool: $worktree/buildtools/gn"
        missing=1
    fi
    if [ ! -x "$worktree/buildtools/ninja/ninja" ]; then
        echo "❌ Missing build tool: $worktree/buildtools/ninja/ninja"
        missing=1
    fi
    if [ ! -x "$worktree/tools/sdks/dart-sdk/bin/dart" ]; then
        echo "❌ Missing CIPD prebuilt SDK: $worktree/tools/sdks/dart-sdk/bin/dart"
        missing=1
    fi
    if [ ! -f "$worktree/build/config/gclient_args.gni" ]; then
        echo "❌ Missing gclient generated config: $worktree/build/config/gclient_args.gni"
        missing=1
    fi

    if [ "$missing" -ne 0 ]; then
        echo "❌ Verification failed: Toolchain is incomplete."
        echo "   Run '$SCRIPT_DIR/mkagenttree --sync $worktree' to repair."
        return 1
    fi
    return 0
}

# Check for --sync or --repair mode
if [ "${1:-}" = "--sync" ] || [ "${1:-}" = "--repair" ] || [ "${1:-}" = "-s" ]; then
    TARGET_PATH="${2:-$PWD}"
    if [ -d "$TARGET_PATH/sdk" ]; then
        WORKTREE_DIR="$(cd "$TARGET_PATH/sdk" && pwd)"
    elif [ -f "$TARGET_PATH/DEPS" ] || [ -d "$TARGET_PATH/.git" ]; then
        WORKTREE_DIR="$(cd "$TARGET_PATH" && pwd)"
    else
        echo "❌ Error: Cannot locate Dart SDK worktree in '$TARGET_PATH'."
        echo "   Usage: mkagenttree --sync [path-to-sdk-or-sandbox-worktree]"
        exit 1
    fi

    echo "🔄 Re-syncing Dart SDK worktree at: $WORKTREE_DIR"
    echo "🔗 Syncing external dependencies and CIPD packages..."
    (cd "$WORKTREE_DIR" && gclient sync -D --no-history)
    verify_toolchain "$WORKTREE_DIR"
    echo "✅ Sync complete and toolchain verified!"
    echo "💡 Tip: Ensure depot_tools is on PATH: export PATH=\"\$HOME/github/depot_tools:\$PATH\""
    exit 0
fi

# Standard creation mode: requires <core|bazel> <task-name> [base-ref]
if [ "$#" -lt 2 ]; then
    echo "Usage:"
    echo "  mkagenttree <core|bazel> <task-name> [base-ref]   # Create new sandbox worktree"
    echo "  mkagenttree --sync [path-to-worktree]            # Re-sync / repair existing worktree"
    exit 1
fi

CATEGORY="$1"
TASK_NAME="$2"
BASE_REF="${3:-}"

SANDBOX_DIR="$WORKSPACE_ROOT/$CATEGORY/agent-$TASK_NAME"
WORKTREE_DIR="$SANDBOX_DIR/sdk"
SOURCE_MAIN_DIR="$WORKSPACE_ROOT/$CATEGORY/main"

# Ensure bare repository database exists
if [ ! -d "$BARE_DIR" ]; then
    echo "❌ Error: Bare repository database not found at $BARE_DIR."
    exit 1
fi

# Ensure sandbox does not already exist
if [ -d "$SANDBOX_DIR" ]; then
    echo "❌ Error: Sandbox directory already exists: $SANDBOX_DIR"
    echo "   To remove it, run: $SCRIPT_DIR/rmagenttree $CATEGORY $TASK_NAME"
    echo "   To re-sync it, run: $SCRIPT_DIR/mkagenttree --sync $WORKTREE_DIR"
    exit 1
fi

# Validate base ref if provided
if [ -n "$BASE_REF" ]; then
    if ! git --git-dir="$BARE_DIR" rev-parse --verify "$BASE_REF^{commit}" &>/dev/null; then
        echo "❌ Error: Base ref '$BASE_REF' cannot be resolved in $BARE_DIR."
        echo "   Run 'git --git-dir=$BARE_DIR fetch --all' and check the ref name."
        exit 1
    fi
fi

echo "🚀 Creating $CATEGORY sandbox: agent-$TASK_NAME using gclient-new-workdir..."

# 2. Pre-warm and sanitize root checkout dependencies if present
if [ -d "$SOURCE_MAIN_DIR/sdk" ]; then
    echo "🔗 Pre-warming root checkout dependencies ($SOURCE_MAIN_DIR/sdk)..."
    (cd "$SOURCE_MAIN_DIR/sdk" && gclient sync -D --force --no-history) || echo "⚠️ Root gclient sync encountered non-fatal warnings; proceeding with workdir clone..."
fi

# 3. Use gclient-new-workdir.py to clone workspace layout from main
if [ -d "$SOURCE_MAIN_DIR" ]; then
    gclient-new-workdir.py --max-depth 1 "$SOURCE_MAIN_DIR" "$SANDBOX_DIR"
    # Decouple .gclient: replace symlink with standalone copy so per-sandbox custom_vars don't mutate main
    if [ -L "$SANDBOX_DIR/.gclient" ]; then
        cp -L "$SANDBOX_DIR/.gclient" "$SANDBOX_DIR/.gclient.tmp"
        mv "$SANDBOX_DIR/.gclient.tmp" "$SANDBOX_DIR/.gclient"
    fi
else
    # Fallback to manual setup if main root dir doesn't exist
    mkdir -p "$SANDBOX_DIR"
    git --git-dir="$BARE_DIR" worktree add "$WORKTREE_DIR" "${BASE_REF:-upstream-sdk/main}"
    cat > "$SANDBOX_DIR/.gclient" <<EOF
solutions = [
  {
    "name": "sdk",
    "url": "https://github.com/dart-lang/sdk.git",
    "deps_file": "DEPS",
    "managed": False,
    "custom_deps": {},
    "custom_vars": {},
  },
]
EOF
fi

# 4. Checkout explicit base ref if requested
if [ -n "$BASE_REF" ]; then
    echo "🔀 Checking out requested base ref: $BASE_REF..."
    (cd "$WORKTREE_DIR" && git checkout --detach "$BASE_REF")
fi

# 5. Fast Sync Dependencies using shared git cache
echo "🔗 Syncing external dependencies and CIPD packages..."
if ! (cd "$WORKTREE_DIR" && gclient sync -D --no-history); then
    echo "❌ Error: gclient sync failed in $WORKTREE_DIR."
    echo "   Remediation steps:"
    echo "   1. If gcert expired during sync, run 'gcert' in your terminal."
    echo "   2. Re-sync via: $SCRIPT_DIR/mkagenttree --sync $WORKTREE_DIR"
    echo "   3. Or tear down via: $SCRIPT_DIR/rmagenttree $CATEGORY $TASK_NAME"
    exit 1
fi

# 6. Empirical Post-Bootstrap Verification Gate
verify_toolchain "$WORKTREE_DIR"

# 7. Hydrate Beads database if .beads exists but local storage is unhydrated
if [ -d "$WORKTREE_DIR/.beads" ] && [ ! -d "$WORKTREE_DIR/.beads/embeddeddolt" ] && [ ! -d "$WORKTREE_DIR/.beads/dolt" ]; then
    echo "📊 Hydrating Beads issue database from remote..."
    (cd "$WORKTREE_DIR" && bd bootstrap)
fi

echo "✅ Sandbox ready! You can now cd into: $WORKTREE_DIR"
echo "💡 Tip: Ensure depot_tools is on PATH: export PATH=\"\$HOME/github/depot_tools:\$PATH\""
